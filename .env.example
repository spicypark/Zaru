# Copy to server/.env (server vars) and web/.env.local (VITE_ vars). Never commit real values.

# --- server ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

OTEL_SERVICE_NAME=zaru-server
# Dash0 "OTLP via HTTP" endpoint, e.g. https://ingress.<region>.aws.dash0.com
OTEL_EXPORTER_OTLP_ENDPOINT=
# %20 is the URL-encoded space after "Bearer"
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<server-ingest-token>,Dash0-Dataset=default

# --- web (baked in at build time; use an ingest-only token, it is visible in the browser) ---
VITE_DASH0_ENDPOINT=
VITE_DASH0_AUTH_TOKEN=
VITE_DASH0_DATASET=default

# --- captions fallback ---
# auto = OpenAI when the key works, else the local Whisper model; or force openai / local
TRANSCRIPTION_BACKEND=auto
LOCAL_WHISPER_MODEL=small.en
# 1 = greedy (default); 5 = beam search (slower, not measurably better here)
LOCAL_WHISPER_BEAM_SIZE=1
